# URL de connexion Postgres (fournie automatiquement par Vercel si tu utilises
# le marketplace Storage -> Neon ; sinon copie l'URL de ta base Postgres).
DATABASE_URL="postgresql://user:password@host:5432/familytree"

# Cle secrete pour signer les cookies de session (generer une valeur aleatoire
# en production, ex: openssl rand -hex 32)
AUTH_SECRET="change-me"
# Mot de passe pour modifier l'arbre (ajouter/editer/supprimer)
SITE_EDIT_PASSWORD="change-me"

# Optionnel : token Vercel Blob pour l'upload de photos en production
# (fourni automatiquement si tu connectes un Blob store au projet Vercel).
# En local, sans ce token, les photos sont enregistrees sur le disque.
BLOB_READ_WRITE_TOKEN=""
